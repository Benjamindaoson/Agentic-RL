# Local paths; do not commit real secrets.
DATA_ROOT=./data
SPIDER_ROOT=./data/raw/spider
BIRD_DB_ROOT=/data/bird/dev_databases
RUN_ROOT=./runs

# Remote training: immutable 40-hex HF commit SHA; or use predownloaded local model.
MODEL=Qwen/Qwen2.5-Coder-3B-Instruct
MODEL_REVISION=
POLICY_TOKENIZER_PATH=Qwen/Qwen2.5-Coder-3B-Instruct

# Private local Agent Lightning endpoint
AGL_SERVER_PORT=8181
AGL_KEY=agentic-rl-dev-key

# Compute and rollout budgets
CONTEXT_LENGTH=4096
MAX_TURNS=1
ROLLOUT_MAX_TOKENS=1024
ROLLOUT_TEMPERATURE=0.7
MAX_SCHEMA_CHARS=12000
SQL_MAX_ROWS=100000
SQL_TIMEOUT_SECONDS=8

REWARD_CONFIG=./configs/reward.yaml
REWARD_MODE=execution
GPU_MEMORY_UTILIZATION=0.65
