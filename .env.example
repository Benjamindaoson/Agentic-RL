# Prepared dataset and database root
DATA_ROOT=/data/agentic_rl
SPIDER_ROOT=/data/spider
BIRD_DB_ROOT=/data/bird/train_databases
RUN_ROOT=/runs/agentic_rl

# Policy model
MODEL=Qwen/Qwen2.5-Coder-3B-Instruct

# Agent Lightning
AGL_SERVER_PORT=8181
AGL_KEY=agentic-rl-dev-key

# Rollout controls
MAX_TURNS=3
MAX_SCHEMA_CHARS=12000
MAX_RESULT_ROWS=20
SQL_TIMEOUT_SECONDS=8
